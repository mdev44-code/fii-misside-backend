# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME="Association Village"
APP_VERSION="1.0.0"
ENVIRONMENT="development"        # development | staging | production
DEBUG=true
FRONTEND_URL="http://localhost:5173"

# ─── API ───────────────────────────────────────────────────────────────────────
API_PREFIX="/api/v1"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ─── Base de données ────────────────────────────────────────────────────────────
DATABASE_URL=""
DATABASE_URL_SYNC=""
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY="CHANGE_ME_in_production_use_openssl_rand_hex_32"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Invitation ─────────────────────────────────────────────────────────────────
INVITATION_TOKEN_EXPIRE_HOURS=72

# ─── SMS — AfricasTalking ───────────────────────────────────────────────────────
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="your_api_key_here"
AFRICASTALKING_SENDER_ID="ASSOC"   # ID affiché sur le SMS (optionnel selon pays)

# ─── Cotisations ────────────────────────────────────────────────────────────────
CONTRIBUTION_AMOUNT=5000           # Montant fixe en FCFA
CONTRIBUTION_REMINDER_START_DAY=1  # Début période de cotisation
CONTRIBUTION_REMINDER_END_DAY=15   # Fin période (rappels arrêtés après)
CONTRIBUTION_REMINDER_HOUR=9       # Heure d'envoi des rappels (matin)

# ─── Wave ──────────────────────────────────────────────────────────────────────
WAVE_TREASURER_NUMBER="+221XXXXXXXXX"   # Numéro Wave du comptable affiché aux membres

# ─── Admin initial ─────────────────────────────────────────────────────────────
FIRST_ADMIN_EMAIL="admin@association.com"
FIRST_ADMIN_PHONE="+221XXXXXXXXX"


SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="<ton login SMTP Brevo>"
SMTP_PASSWORD="<ta clé SMTP Brevo>"
SMTP_FROM_EMAIL="no-reply@fii-misside.org"
SMTP_FROM_NAME=""
SMTP_USE_TLS=true